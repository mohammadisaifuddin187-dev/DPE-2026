<!-- KI-generiert (Claude, Anthropic) - Beginn. Team 2 Materialversorgung, Pflege-Backoffice MVP, DPE WS 2026/27 (Prof. Stiehl). Verantwortlich im Team: Saifudin Mohammadi (BPMN). Lizenz: MIT. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_T2_Lieferpruefung" targetNamespace="http://thi.de/dpe/team2" exporter="Team 2 (KI-unterstützt)" exporterVersion="1.0">
<bpmn:collaboration id="Collab_T2_Lieferpruefung">
<bpmn:participant id="P_Lieferant" name="Lieferant (simuliert)" />
<bpmn:participant id="P_PflegeApp" name="Pflege-App" />
<bpmn:participant id="P_Lieferpruefung" name="Lieferprüfung - Materialversorgung (Team 2)" processRef="T2_Lieferpruefung" />
<bpmn:participant id="P_Team3" name="Team 3 - Kommunikation, Fristen, Nachfassen" />
<bpmn:messageFlow id="M01" name="Versand-Meldung" sourceRef="P_Lieferant" targetRef="R_Versand" />
<bpmn:messageFlow id="M02" name="Bestätigungs-Anfrage" sourceRef="S_Anfrage" targetRef="P_PflegeApp" />
<bpmn:messageFlow id="M03" name="Liefer-Bestätigung" sourceRef="P_PflegeApp" targetRef="R_Bestaetigung" />
<bpmn:messageFlow id="M04" name="Klärungs-Auftrag" sourceRef="S_Klaerung" targetRef="P_Team3" />
<bpmn:messageFlow id="M05" name="Klärungs-Ergebnis" sourceRef="P_Team3" targetRef="R_Klaerung" />
</bpmn:collaboration>
<bpmn:process id="T2_Lieferpruefung" name="Lieferprüfung" isExecutable="true" camunda:historyTimeToLive="P180D">
<bpmn:documentation>Teilprozess zu Schritt 9 und 10. Die Pflegeperson bestätigt über die Pflege-App. Jede Frist und jede Abweichung geht an Team 3 (Klärung). Abgeschlossen nur bei bestätigter (Nach-)Lieferung.</bpmn:documentation>
<bpmn:startEvent id="Start" name="Bestellung bestätigt"><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
<bpmn:receiveTask id="R_Versand" name="Versandmeldung empfangen" messageRef="Msg_Versandmeldung"><bpmn:documentation>Lieferant meldet Versand und erwartetes Lieferdatum (über Camel).</bpmn:documentation><bpmn:incoming>F01</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:receiveTask>
<bpmn:boundaryEvent id="B_Versand" name="Versandfrist abgelaufen (5 Tage)" attachedToRef="R_Versand"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): Versandfrist 5 Tage.</bpmn:documentation><bpmn:outgoing>F07</bpmn:outgoing><bpmn:timerEventDefinition id="B_Versand_Def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:sendTask id="S_Anfrage" name="Lieferbestätigung anfordern" camunda:type="external" camunda:topic="t2-lieferbestaetigung-anfordern"><bpmn:documentation>Nachricht an die Pflege-App: erwarteter Inhalt und Liefertermin, Bitte um Bestätigung.</bpmn:documentation><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:sendTask>
<bpmn:receiveTask id="R_Bestaetigung" name="Lieferbestätigung empfangen" messageRef="Msg_Lieferbestaetigung"><bpmn:documentation>lieferbefund: RICHTIG, TEILWEISE, FALSCH oder NICHT_GELIEFERT.</bpmn:documentation><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:receiveTask>
<bpmn:boundaryEvent id="B_Bestaetigung" name="Bestätigungsfrist abgelaufen (3 Tage)" attachedToRef="R_Bestaetigung"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): Bestätigungsfrist 3 Tage.</bpmn:documentation><bpmn:outgoing>F08</bpmn:outgoing><bpmn:timerEventDefinition id="B_Bestaetigung_Def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="GW_Korrekt" name="Lieferung korrekt?"><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing><bpmn:outgoing>F06</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="XOR_Ab" name=""><bpmn:incoming>F05</bpmn:incoming><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Abgeschlossen" name="Lieferung abgeschlossen"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('lieferpruefungErgebnis', 'Lieferung abgeschlossen')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F15</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW_Klaerung" name=""><bpmn:incoming>F06</bpmn:incoming><bpmn:incoming>F07</bpmn:incoming><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="S_Klaerung" name="Klärung beauftragen" camunda:type="external" camunda:topic="t2-klaerung-beauftragen"><bpmn:documentation>Abweichung erfassen, Gegenstelle über Team 3 kontaktieren; Status bleibt offen.</bpmn:documentation><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:sendTask>
<bpmn:receiveTask id="R_Klaerung" name="Klärungsergebnis empfangen" messageRef="Msg_Klaerungsergebnis"><bpmn:documentation>klaerungsergebnis = NACHLIEFERUNG_BESTAETIGT oder NICHT_GEKLAERT. Schnittstelle = Vorschlag.</bpmn:documentation><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:receiveTask>
<bpmn:boundaryEvent id="B_Klaerung" name="Klärungsfrist abgelaufen (7 Tage)" attachedToRef="R_Klaerung"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): Sicherheitsfrist Klärung 7 Tage.</bpmn:documentation><bpmn:outgoing>F14</bpmn:outgoing><bpmn:timerEventDefinition id="B_Klaerung_Def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="GW_Geklaert" name="Nachlieferung bestätigt?"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="XOR_Ue" name=""><bpmn:incoming>F13</bpmn:incoming><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T_Uebergeben" name="Klärungsfall übergeben" camunda:type="external" camunda:topic="t2-klaerungsfall-uebergeben"><bpmn:documentation>Übergabe an die menschliche Prüfstelle von Team 2 mit dokumentiertem Grund (Zustand: Übergeben).</bpmn:documentation><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Ungeklaert" name="Lieferung ungeklärt"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('lieferpruefungErgebnis', 'Lieferung ungeklärt')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F17</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="R_Versand"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F02" sourceRef="R_Versand" targetRef="S_Anfrage"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F03" sourceRef="S_Anfrage" targetRef="R_Bestaetigung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F04" sourceRef="R_Bestaetigung" targetRef="GW_Korrekt"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F05" sourceRef="GW_Korrekt" targetRef="XOR_Ab" name="Richtig geliefert"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lieferbefund == 'RICHTIG'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F06" sourceRef="GW_Korrekt" targetRef="GW_Klaerung" name="Abweichung festgestellt"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lieferbefund != 'RICHTIG'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F07" sourceRef="B_Versand" targetRef="GW_Klaerung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F08" sourceRef="B_Bestaetigung" targetRef="GW_Klaerung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F09" sourceRef="GW_Klaerung" targetRef="S_Klaerung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F10" sourceRef="S_Klaerung" targetRef="R_Klaerung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F11" sourceRef="R_Klaerung" targetRef="GW_Geklaert"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F12" sourceRef="GW_Geklaert" targetRef="XOR_Ab" name="Ja"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${klaerungsergebnis == 'NACHLIEFERUNG_BESTAETIGT'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F13" sourceRef="GW_Geklaert" targetRef="XOR_Ue" name="Nein"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${klaerungsergebnis != 'NACHLIEFERUNG_BESTAETIGT'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F14" sourceRef="B_Klaerung" targetRef="XOR_Ue"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F15" sourceRef="XOR_Ab" targetRef="End_Abgeschlossen"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F16" sourceRef="XOR_Ue" targetRef="T_Uebergeben"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F17" sourceRef="T_Uebergeben" targetRef="End_Ungeklaert"></bpmn:sequenceFlow>
</bpmn:process>
<bpmn:message id="Msg_Versandmeldung" name="Lieferant_Versandmeldung_Team2" />
<bpmn:message id="Msg_Lieferbestaetigung" name="PflegeApp_Lieferbestaetigung_Team2" />
<bpmn:message id="Msg_Klaerungsergebnis" name="Team3_Klaerungsergebnis_Team2" />
