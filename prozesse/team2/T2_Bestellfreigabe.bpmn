<!-- KI-generiert (Claude, Anthropic) - Beginn. Team 2 Materialversorgung, Pflege-Backoffice MVP, DPE WS 2026/27 (Prof. Stiehl). Verantwortlich im Team: offen (Team 2 legt fest). Lizenz: MIT. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_T2_Bestellfreigabe" targetNamespace="http://thi.de/dpe/team2" exporter="Team 2 (KI-unterstützt)" exporterVersion="1.0">
<bpmn:collaboration id="Collab_T2_Bestellfreigabe">
<bpmn:participant id="P_Bestellfreigabe" name="Bestellfreigabe" processRef="T2_Bestellfreigabe" />
</bpmn:collaboration>
<bpmn:process id="T2_Bestellfreigabe" name="Bestellfreigabe" isExecutable="true" camunda:historyTimeToLive="P180D">
<bpmn:documentation>Teilprozess zu Schritt 4-7: Produkt und Menge vorschlagen, Abweichungen prüfen, Berechtigungsregel anwenden, Kundenentscheidung einholen. Deckt Ausnahmen Preisgrenze, Verbrauchssprung, Produkt nicht verfügbar (nur hinterlegte Ersatzoptionen) sowie Ablehnung/Aufschub ab.</bpmn:documentation>
<bpmn:laneSet id="T2_Bestellfreigabe_LaneSet">
<bpmn:lane id="Lane_Backoffice" name="Pflege-Backoffice"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Vorschlag</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Abweichung</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Regel</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Weg</bpmn:flowNodeRef><bpmn:flowNodeRef>CA_KE</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_KE</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Freigegeben</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Risiko</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NichtFreigegeben</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Weiter</bpmn:flowNodeRef><bpmn:flowNodeRef>End_KeineEinigung</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Pruefstelle" name="Menschliche Prüfstelle"><bpmn:flowNodeRef>UT_Grenzfall</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Pruef</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NichtZulaessig</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start" name="Bestellvorschlag angefordert"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('anzahlVorschlaege', 0)}" event="start" /></bpmn:extensionElements><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="T_Vorschlag" name="Produkt und Menge vorschlagen" camunda:type="external" camunda:topic="t2-vorschlag-erstellen"><bpmn:documentation>Vorschlag gemäß hinterlegter Auswahl, Packungsgröße und Zielbestand. Bei ersatzGrund oder Änderungswunsch nur hinterlegte Ersatzoptionen (keine medizinische Ersatzbestimmung). Zählt die Vorschläge (anzahlVorschlaege, höchstens 3).</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('anzahlVorschlaege', anzahlVorschlaege + 1)}" event="end" /></bpmn:extensionElements><bpmn:incoming>F01</bpmn:incoming><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="T_Abweichung" name="Abweichungen prüfen" camunda:type="external" camunda:topic="t2-abweichungen-pruefen"><bpmn:documentation>Bewertet Preis, Produktwechsel, Verbrauchssprung, Lieferant und Menge; bereitet die Freigabeanfrage (Handlung, Begründung, Folgen, Gültigkeit) vor.</bpmn:documentation><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:serviceTask>
<bpmn:businessRuleTask id="T_Regel" name="Berechtigungsregel anwenden" camunda:type="external" camunda:topic="t2-berechtigung-pruefen"><bpmn:documentation>Gemeinsame Berechtigungsprüfung (Team 2). Ergebnis freigabeweg: AUTOMATISCH, KUNDENFREIGABE oder PRUEFUNG. Später als DMN-Tabelle.</bpmn:documentation><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="GW_Weg" name="Freigabeweg?"><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing><bpmn:outgoing>F06</bpmn:outgoing><bpmn:outgoing>F07</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:callActivity id="CA_KE" name="Kundenentscheidung" calledElement="T2_Kundenentscheidung" camunda:calledElementBinding="latest"><bpmn:documentation>Aufruf des gemeinsamen Bausteins Kundenentscheidung (auch für Team 1 und Team 3).</bpmn:documentation><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="freigabeHandlung" target="freigabeHandlung" /><camunda:in source="freigabeBegruendung" target="freigabeBegruendung" /><camunda:in source="freigabeFolgen" target="freigabeFolgen" /><camunda:in source="freigabeGueltigBis" target="freigabeGueltigBis" /><camunda:out source="kundenentscheidungErgebnis" target="kundenentscheidungErgebnis" /><camunda:out source="kundenentscheidungKommentar" target="kundenentscheidungKommentar" /></bpmn:extensionElements><bpmn:incoming>F05</bpmn:incoming><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_KE" name="Entscheidung?"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing><bpmn:outgoing>F14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="GW_Weiter" name="Weiterer Vorschlag möglich?"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_KeineEinigung" name="Keine Einigung"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): höchstens 3 Vorschläge je Bestellfreigabe, danach Ende ohne Bestellung.</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bestellfreigabeErgebnis', 'Keine Einigung')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F17</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_Freigegeben" name="Bestellung freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bestellfreigabeErgebnis', 'Bestellung freigegeben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F06</bpmn:incoming><bpmn:incoming>F12</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="T_Risiko" name="Reichweitenrisiko mitteilen" camunda:type="external" camunda:topic="t2-benachrichtigung"><bpmn:documentation>Bestellung wird nicht ausgelöst; Reichweitenrisiko wird der Pflegeperson sichtbar gemacht.</bpmn:documentation><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="vorlage">REICHWEITENRISIKO</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_NichtFreigegeben" name="Bestellung nicht freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bestellfreigabeErgebnis', 'Bestellung nicht freigegeben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F15</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="UT_Grenzfall" name="Grenzfall prüfen" camunda:candidateGroups="pruefstelle"><bpmn:documentation>Anlass: ungewöhnlicher Verbrauch, ungeklärtes Produkt oder fachlicher Grenzfall (Regel = PRUEFUNG). Benötigt: Vorschlag und festgestellte Abweichungen. Rolle: menschliche Prüfstelle. Ergebnis: Kundenfreigabe einholen oder nicht zulässig, jeweils mit Begründung.</bpmn:documentation><bpmn:extensionElements><camunda:formData><camunda:formField id="freigabeBegruendung" label="Anlass der Prüfung" type="string"><camunda:validation><camunda:constraint name="readonly" /></camunda:validation></camunda:formField><camunda:formField id="pruefergebnis" label="Prüfergebnis" type="enum"><camunda:validation><camunda:constraint name="required" /></camunda:validation><camunda:value id="KUNDENFREIGABE" name="Kundenfreigabe einholen" /><camunda:value id="NICHT_ZULAESSIG" name="Nicht zulässig" /></camunda:formField><camunda:formField id="pruefbegruendung" label="Begründung" type="string"><camunda:validation><camunda:constraint name="required" /></camunda:validation></camunda:formField></camunda:formData></bpmn:extensionElements><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="GW_Pruef" name="Prüfergebnis?"><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_NichtZulaessig" name="Bestellung nicht zulässig"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bestellfreigabeErgebnis', 'Bestellung nicht zulässig')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="T_Vorschlag"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F02" sourceRef="T_Vorschlag" targetRef="T_Abweichung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F03" sourceRef="T_Abweichung" targetRef="T_Regel"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F04" sourceRef="T_Regel" targetRef="GW_Weg"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F05" sourceRef="GW_Weg" targetRef="CA_KE" name="Kundenfreigabe erforderlich"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${freigabeweg == 'KUNDENFREIGABE'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F06" sourceRef="GW_Weg" targetRef="End_Freigegeben" name="Automatisch zulässig"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${freigabeweg == 'AUTOMATISCH'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F07" sourceRef="GW_Weg" targetRef="UT_Grenzfall" name="Prüfung erforderlich"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${freigabeweg == 'PRUEFUNG'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F08" sourceRef="UT_Grenzfall" targetRef="GW_Pruef"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F09" sourceRef="GW_Pruef" targetRef="CA_KE" name="Kundenfreigabe einholen"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pruefergebnis == 'KUNDENFREIGABE'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F10" sourceRef="GW_Pruef" targetRef="End_NichtZulaessig" name="Nicht zulässig"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pruefergebnis == 'NICHT_ZULAESSIG'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F11" sourceRef="CA_KE" targetRef="GW_KE"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F12" sourceRef="GW_KE" targetRef="End_Freigegeben" name="Freigegeben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kundenentscheidungErgebnis == 'Freigegeben'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F13" sourceRef="GW_KE" targetRef="T_Risiko" name="Nicht freigegeben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kundenentscheidungErgebnis == 'Nicht freigegeben'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F14" sourceRef="GW_KE" targetRef="GW_Weiter" name="Änderung gewünscht"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kundenentscheidungErgebnis == 'Änderung gewünscht'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F16" sourceRef="GW_Weiter" targetRef="T_Vorschlag" name="Ja"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${anzahlVorschlaege &lt; 3}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F17" sourceRef="GW_Weiter" targetRef="End_KeineEinigung" name="Nein"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${anzahlVorschlaege &gt;= 3}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F15" sourceRef="T_Risiko" targetRef="End_NichtFreigegeben"></bpmn:sequenceFlow>
</bpmn:process>
