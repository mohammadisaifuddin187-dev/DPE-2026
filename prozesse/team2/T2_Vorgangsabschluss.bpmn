<bpmn:documentation>Teilprozess zu Schritt 11 (Bestand und Verbrauch fortschreiben) und 12 (Beleg übergeben und Vorgang schließen).</bpmn:documentation>
<bpmn:startEvent id="Start" name="Lieferung abgeschlossen"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="T_Fortschreiben" name="Bestand und Verbrauch fortschreiben" camunda:type="external" camunda:topic="t2-bestand-fortschreiben"><bpmn:documentation>Neuer Bestand, neue Reichweite und nächster Prüfzeitpunkt werden festgelegt.</bpmn:documentation><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="S_Nachweis" name="Liefernachweis übergeben" camunda:type="external" camunda:topic="t2-nachweis-uebergeben"><bpmn:documentation>Übergabe an Team 1 (Bestellbeleg/Liefernachweis mit Pflegehaushalt, Bestellung, Herkunft, Ergebnis). Schnittstelle = Vorschlag zur Abstimmung im Integrationskreis.</bpmn:documentation><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:sendTask>
<bpmn:serviceTask id="T_Mitteilen" name="Ergebnis mitteilen" camunda:type="external" camunda:topic="t2-benachrichtigung"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="vorlage">ERGEBNIS</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End" name="Vorgang geschlossen"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Fortschreiben"></bpmn:sequenceFlow>
