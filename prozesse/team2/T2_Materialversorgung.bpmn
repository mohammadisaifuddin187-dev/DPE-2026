<bpmn:sequenceFlow id="F16" sourceRef="GW_Bestellung" targetRef="CA_Lieferpruefung" name="Bestellung bestätigt"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellabwicklungErgebnis == 'Bestellung bestätigt'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F17" sourceRef="GW_Bestellung" targetRef="CA_Bestellfreigabe" name="Ersatz erforderlich"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellabwicklungErgebnis == 'Ersatz erforderlich'}</bpmn:conditionExpression></bpmn:sequenceFlow>
