<?xml version="1.0" encoding="UTF-8"?>
<!-- KI-generiert (Claude, Anthropic) - Beginn. Team 2 Materialversorgung, Pflege-Backoffice MVP, DPE WS 2026/27 (Prof. Stiehl). Verantwortlich im Team: Saifudin Mohammadi (BPMN). Lizenz: MIT. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_T2_Materialversorgung" targetNamespace="http://thi.de/dpe/team2" exporter="Team 2 (KI-unterstützt)" exporterVersion="1.0">
<bpmn:collaboration id="Collab_T2_Materialversorgung">
<bpmn:participant id="P_Team3" name="Team 3 - Kommunikation, Fristen, Nachfassen" />
<bpmn:participant id="P_Lieferant" name="Lieferant (simuliert)" />
<bpmn:participant id="P_PflegeApp" name="Pflege-App" />
<bpmn:participant id="P_Materialversorgung" name="Materialversorgung (Team 2)" processRef="T2_Materialversorgung" />
<bpmn:participant id="P_Team1" name="Team 1 - Verwaltung und Erstattung" />
<bpmn:messageFlow id="M01" name="Bestandsmeldung" sourceRef="P_PflegeApp" targetRef="Start_Manuell" />
<bpmn:messageFlow id="M02" name="Freigabe-Anfrage" sourceRef="CA_Bestellfreigabe" targetRef="P_PflegeApp" />
<bpmn:messageFlow id="M03" name="Kunden-Entscheidung" sourceRef="P_PflegeApp" targetRef="CA_Bestellfreigabe" />
<bpmn:messageFlow id="M04" name="Nachfass-Auftrag" sourceRef="CA_Bestellfreigabe" targetRef="P_Team3" />
<bpmn:messageFlow id="M05" name="Ergebnis" sourceRef="End_NichtZulaessig" targetRef="P_PflegeApp" />
<bpmn:messageFlow id="M06" name="Ergebnis" sourceRef="End_NichtFreigegeben" targetRef="P_PflegeApp" />
<bpmn:messageFlow id="M07" name="Ergebnis" sourceRef="End_Aufgeschoben" targetRef="P_PflegeApp" />
<bpmn:messageFlow id="M08" name="Bestellung" sourceRef="CA_Bestellabwicklung" targetRef="P_Lieferant" />
<bpmn:messageFlow id="M09" name="Bestell-Antwort" sourceRef="P_Lieferant" targetRef="CA_Bestellabwicklung" />
<bpmn:messageFlow id="M10" name="Nachfass-Auftrag" sourceRef="CA_Bestellabwicklung" targetRef="P_Team3" />
<bpmn:messageFlow id="M11" name="Ergebnis" sourceRef="End_KeineBestellung" targetRef="P_PflegeApp" />
<bpmn:messageFlow id="M12" name="Versand-Meldung" sourceRef="P_Lieferant" targetRef="CA_Lieferpruefung" />
<bpmn:messageFlow id="M13" name="Bestätigungs-Anfrage" sourceRef="CA_Lieferpruefung" targetRef="P_PflegeApp" />
<bpmn:messageFlow id="M14" name="Liefer-Bestätigung" sourceRef="P_PflegeApp" targetRef="CA_Lieferpruefung" />
<bpmn:messageFlow id="M15" name="Klärungs-Auftrag" sourceRef="CA_Lieferpruefung" targetRef="P_Team3" />
<bpmn:messageFlow id="M16" name="Klärungs-Ergebnis" sourceRef="P_Team3" targetRef="CA_Lieferpruefung" />
<bpmn:messageFlow id="M17" name="Ergebnis" sourceRef="End_Ungeklaert" targetRef="P_PflegeApp" />
<bpmn:messageFlow id="M18" name="Liefernachweis" sourceRef="SA_Nachweis" targetRef="P_Team1" />
<bpmn:messageFlow id="M19" name="Ergebnis" sourceRef="SA_Ergebnis" targetRef="P_PflegeApp" />
</bpmn:collaboration>
<bpmn:process id="T2_Materialversorgung" name="Materialversorgung" isExecutable="true" camunda:historyTimeToLive="P180D">
<bpmn:documentation>Hauptprozess Team 2: Verbrauchsprodukte rechtzeitig und kontrolliert nachversorgen (Teamauftrag 2). Eine Instanz = ein Nachversorgungsvorgang für ein Produkt eines Pflegehaushalts (Business Key PH-&lt;Haushalt&gt;:&lt;Produkt&gt;). Den Ist-Bestand führt Team 2 in der eigenen Datenbank. Jedes Ende ohne Lieferung meldet Ergebnis und Reichweitenrisiko an die Pflege-App (Stiehl Punkt 3).</bpmn:documentation>
<bpmn:startEvent id="Start_Timer" name="Prüftermin erreicht (alle 10 Tage)"><bpmn:documentation>Zyklischer Timer-Start. Er ersetzt jedes eigene Terminieren (Stiehl Punkt 1). Offen (Stiehl): Zuordnung der fälligen Haushalte/Produkte zu den Instanzen.</bpmn:documentation><bpmn:outgoing>F03</bpmn:outgoing><bpmn:timerEventDefinition id="Start_Timer_Def"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P10D</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:startEvent id="Start_Manuell" name="Bestand manuell gemeldet"><bpmn:documentation>Die Pflegeperson meldet über die Pflege-App einen abweichenden Ist-Bestand.</bpmn:documentation><bpmn:outgoing>F01</bpmn:outgoing><bpmn:messageEventDefinition id="Start_Manuell_Def" messageRef="Msg_Bestandsmeldung" /></bpmn:startEvent>
<bpmn:startEvent id="Start_Bedingt" name="Bestand unterschritten"><bpmn:documentation>Bedingter Start auf den Bestand der eigenen Datenbank. CIB seven: nach jeder Bestandsänderung REST "POST /condition" (die Engine überwacht keine Tabellen).</bpmn:documentation><bpmn:outgoing>F02</bpmn:outgoing><bpmn:conditionalEventDefinition id="Start_Bedingt_Def"><bpmn:condition xsi:type="bpmn:tFormalExpression">${bestandMenge &lt; mindestbestand}</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:startEvent>
<bpmn:exclusiveGateway id="GW_Start" name=""><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('anzahlBestellversuche', 0)}" event="start" /></bpmn:extensionElements><bpmn:incoming>F01</bpmn:incoming><bpmn:incoming>F02</bpmn:incoming><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T_Offen" name="Laufenden Vorgang prüfen" camunda:type="external" camunda:topic="t2-vorgang-pruefen"><bpmn:documentation>Sucht eine laufende Instanz mit gleichem Business Key PH-&lt;Haushalt&gt;:&lt;Produkt&gt; (Stiehl Punkt 2). Ergebnis vorgangOffen (true/false). So kann kein zweiter Durchlauf doppelt bestellen.</bpmn:documentation><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW_Offen" name="Vorgang bereits offen?"><bpmn:incoming>F05</bpmn:incoming><bpmn:outgoing>F06</bpmn:outgoing><bpmn:outgoing>F07</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Offen" name="Vorgang bereits offen"><bpmn:documentation>Kein zweiter Vorgang; der laufende Vorgang arbeitet mit dem aktuellen Bestand aus der Datenbank.</bpmn:documentation><bpmn:incoming>F06</bpmn:incoming></bpmn:endEvent>
<bpmn:subProcess id="SP_Bedarf" name="Bedarfsermittlung"><bpmn:documentation>Eingebetteter Teilprozess (wenige Schritte). Er liefert nur Daten (nachversorgungErforderlich); entschieden wird erst am Gateway danach (Stiehl Punkt 8).</bpmn:documentation><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing><bpmn:startEvent id="SB_Start" name="Bedarfsprüfung begonnen"><bpmn:outgoing>SF1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="SB_Reichweite" name="Verbrauch und Reichweite berechnen" camunda:type="external" camunda:topic="t2-reichweite-berechnen"><bpmn:documentation>Liest Ist-Bestand, Verbrauchsannahme, Mindest- und Zielbestand, Lieferzeit und Prüfintervall aus der eigenen Datenbank und setzt sie als Variablen für die DMN (istBestand, verbrauchProTag, mindestbestand, zielbestand, lieferzeitTage, tageBisPruefung). Setzt verbrauchssprung bei deutlich verändertem Verbrauch.</bpmn:documentation><bpmn:incoming>SF1</bpmn:incoming><bpmn:outgoing>SF2</bpmn:outgoing></bpmn:serviceTask><bpmn:businessRuleTask id="SB_Bedarf" name="Nachversorgungsbedarf feststellen" camunda:decisionRef="Nachversorgungsbedarf" camunda:decisionRefBinding="latest" camunda:mapDecisionResult="singleResult" camunda:resultVariable="bedarfErgebnis"><bpmn:documentation>DMN "Nachversorgungsbedarf": Reicht der Bestand bis zum nächsten Prüftermin plus Lieferzeit? Ergebnis nachversorgungErforderlich, nachversorgungsbedarf, bedarfsbegruendung. Die Engine wertet die Tabelle T2_Nachversorgungsbedarf.dmn selbst aus (decisionRef, kein Worker). Eingaben setzt "Verbrauch und Reichweite berechnen": istBestand, verbrauchProTag, tageBisPruefung, lieferzeitTage, mindestbestand, zielbestand.</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('nachversorgungErforderlich', bedarfErgebnis.nachversorgungErforderlich)}" event="end" /><camunda:executionListener expression="${execution.setVariable('nachversorgungsbedarf', bedarfErgebnis.nachversorgungsbedarf)}" event="end" /><camunda:executionListener expression="${execution.setVariable('bedarfsbegruendung', bedarfErgebnis.bedarfsbegruendung)}" event="end" /></bpmn:extensionElements><bpmn:incoming>SF2</bpmn:incoming><bpmn:outgoing>SF3</bpmn:outgoing></bpmn:businessRuleTask><bpmn:endEvent id="SB_End" name="Bedarf ermittelt"><bpmn:incoming>SF3</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="SF1" sourceRef="SB_Start" targetRef="SB_Reichweite"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SF2" sourceRef="SB_Reichweite" targetRef="SB_Bedarf"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SF3" sourceRef="SB_Bedarf" targetRef="SB_End"></bpmn:sequenceFlow></bpmn:subProcess>
<bpmn:exclusiveGateway id="GW_Bedarf" name="Nachversorgung erforderlich?"><bpmn:documentation>Entscheidet auf den Daten der Bedarfsermittlung (nachversorgungErforderlich).</bpmn:documentation><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Ausreichend" name="Bestand ausreichend"><bpmn:documentation>Kein Handlungsbedarf; der nächste zyklische Timer prüft erneut.</bpmn:documentation><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="XOR_BF" name=""><bpmn:incoming>F09</bpmn:incoming><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:callActivity id="CA_Bestellfreigabe" name="Bestellfreigabe" calledElement="T2_Bestellfreigabe" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="produktId" target="produktId" /><camunda:in source="nachversorgungsbedarf" target="nachversorgungsbedarf" /><camunda:in source="verbrauchssprung" target="verbrauchssprung" /><camunda:in source="ersatzGrund" target="ersatzGrund" /><camunda:in source="anzahlBestellversuche" target="anzahlBestellversuche" /><camunda:out source="bestellfreigabeErgebnis" target="bestellfreigabeErgebnis" /><camunda:out source="bestellvorschlag" target="bestellvorschlag" /><camunda:out source="ablehnungsgrund" target="ablehnungsgrund" /></bpmn:extensionElements><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_Freigabe" name="Bestellung freigegeben?"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing><bpmn:outgoing>F14</bpmn:outgoing><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_NichtZulaessig" name="Bestellung nicht zulässig"><bpmn:documentation>Sendendes Nachrichten-Endereignis: meldet Ergebnis und Reichweitenrisiko an die Pflege-App und schreibt den Vorgang (Zustand, Grund) in der Datenbank fort (Stiehl Punkt 3).</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangszustand', 'Erfolglos abgeschlossen')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F14</bpmn:incoming><bpmn:messageEventDefinition id="End_NichtZulaessig_Def" camunda:type="external" camunda:topic="t2-ergebnis-mitteilen" /></bpmn:endEvent>
<bpmn:endEvent id="End_NichtFreigegeben" name="Bestellung nicht freigegeben"><bpmn:documentation>Sendendes Nachrichten-Endereignis: meldet Ergebnis und Reichweitenrisiko an die Pflege-App und schreibt den Vorgang (Zustand, Grund) in der Datenbank fort (Stiehl Punkt 3).</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangszustand', 'Erfolglos abgeschlossen')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F15</bpmn:incoming><bpmn:messageEventDefinition id="End_NichtFreigegeben_Def" camunda:type="external" camunda:topic="t2-ergebnis-mitteilen" /></bpmn:endEvent>
<bpmn:endEvent id="End_Aufgeschoben" name="Bestellung aufgeschoben"><bpmn:documentation>Sendendes Nachrichten-Endereignis: meldet Ergebnis und Reichweitenrisiko an die Pflege-App und schreibt den Vorgang (Zustand, Grund) in der Datenbank fort (Stiehl Punkt 3). Aufgeschoben ist keine Ablehnung: Reichweitenrisiko sichtbar machen (Teamauftrag 2, Abschnitt 5); der nächste Prüftermin fragt erneut.</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangszustand', 'Erfolglos abgeschlossen')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F16</bpmn:incoming><bpmn:messageEventDefinition id="End_Aufgeschoben_Def" camunda:type="external" camunda:topic="t2-ergebnis-mitteilen" /></bpmn:endEvent>
<bpmn:callActivity id="CA_Bestellabwicklung" name="Bestellabwicklung" calledElement="T2_Bestellabwicklung" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="bestellvorschlag" target="bestellvorschlag" /><camunda:in source="anzahlBestellversuche" target="anzahlBestellversuche" /><camunda:out source="bestellabwicklungErgebnis" target="bestellabwicklungErgebnis" /><camunda:out source="bestellung" target="bestellung" /><camunda:out source="ersatzGrund" target="ersatzGrund" /><camunda:executionListener expression="${execution.setVariable('anzahlBestellversuche', anzahlBestellversuche + 1)}" event="start" /></bpmn:extensionElements><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_Bestellung" name="Bestellung bestätigt?"><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing><bpmn:outgoing>F19</bpmn:outgoing><bpmn:outgoing>F20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_KeineBestellung" name="Keine Bestellung möglich"><bpmn:documentation>Sendendes Nachrichten-Endereignis: meldet Ergebnis und Reichweitenrisiko an die Pflege-App und schreibt den Vorgang (Zustand, Grund) in der Datenbank fort (Stiehl Punkt 3).</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangszustand', 'Erfolglos abgeschlossen')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F19</bpmn:incoming><bpmn:messageEventDefinition id="End_KeineBestellung_Def" camunda:type="external" camunda:topic="t2-ergebnis-mitteilen" /></bpmn:endEvent>
<bpmn:callActivity id="CA_Lieferpruefung" name="Lieferprüfung" calledElement="T2_Lieferpruefung" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="bestellung" target="bestellung" /><camunda:out source="lieferpruefungErgebnis" target="lieferpruefungErgebnis" /><camunda:out source="lieferung" target="lieferung" /></bpmn:extensionElements><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_Lieferung" name="Lieferung abgeschlossen?"><bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F22</bpmn:outgoing><bpmn:outgoing>F23</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Ungeklaert" name="Lieferung ungeklärt"><bpmn:documentation>Sendendes Nachrichten-Endereignis: meldet Ergebnis und Reichweitenrisiko an die Pflege-App und schreibt den Vorgang (Zustand, Grund) in der Datenbank fort (Stiehl Punkt 3). Der Fall ist an die menschliche Prüfstelle übergeben.</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangszustand', 'Übergeben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F23</bpmn:incoming><bpmn:messageEventDefinition id="End_Ungeklaert_Def" camunda:type="external" camunda:topic="t2-ergebnis-mitteilen" /></bpmn:endEvent>
<bpmn:subProcess id="SP_Abschluss" name="Vorgangsabschluss"><bpmn:documentation>Eingebetteter Teilprozess zu Schritt 11 und 12.</bpmn:documentation><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing><bpmn:startEvent id="SA_Start" name="Abschluss begonnen"><bpmn:outgoing>AF1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="SA_Fortschreiben" name="Bestand und Verbrauch fortschreiben" camunda:type="external" camunda:topic="t2-bestand-fortschreiben"><bpmn:documentation>Neuer Ist-Bestand und neue Reichweite in der eigenen Datenbank.</bpmn:documentation><bpmn:incoming>AF1</bpmn:incoming><bpmn:outgoing>AF2</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="SA_Nachweis" name="Liefernachweis übergeben" camunda:type="external" camunda:topic="t2-nachweis-uebergeben"><bpmn:documentation>An Team 1. Schnittstelle = Vorschlag zur Abstimmung.</bpmn:documentation><bpmn:incoming>AF2</bpmn:incoming><bpmn:outgoing>AF3</bpmn:outgoing></bpmn:sendTask><bpmn:sendTask id="SA_Ergebnis" name="Ergebnis mitteilen" camunda:type="external" camunda:topic="t2-ergebnis-mitteilen"><bpmn:documentation>Nachricht an die Pflege-App: Lieferung abgeschlossen, neuer Bestand.</bpmn:documentation><bpmn:incoming>AF3</bpmn:incoming><bpmn:outgoing>AF4</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="SA_End" name="Vorgang geschlossen"><bpmn:incoming>AF4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AF1" sourceRef="SA_Start" targetRef="SA_Fortschreiben"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AF2" sourceRef="SA_Fortschreiben" targetRef="SA_Nachweis"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AF3" sourceRef="SA_Nachweis" targetRef="SA_Ergebnis"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AF4" sourceRef="SA_Ergebnis" targetRef="SA_End"></bpmn:sequenceFlow></bpmn:subProcess>
<bpmn:endEvent id="End_Abgeschlossen" name="Nachversorgung abgeschlossen"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangszustand', 'Erfolgreich abgeschlossen')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F24</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F01" sourceRef="Start_Manuell" targetRef="GW_Start"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F02" sourceRef="Start_Bedingt" targetRef="GW_Start"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F03" sourceRef="Start_Timer" targetRef="GW_Start"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F04" sourceRef="GW_Start" targetRef="T_Offen"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F05" sourceRef="T_Offen" targetRef="GW_Offen"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F06" sourceRef="GW_Offen" targetRef="End_Offen" name="Ja"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${vorgangOffen}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F07" sourceRef="GW_Offen" targetRef="SP_Bedarf" name="Nein"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!vorgangOffen}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F08" sourceRef="SP_Bedarf" targetRef="GW_Bedarf"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F09" sourceRef="GW_Bedarf" targetRef="XOR_BF" name="Ja"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nachversorgungErforderlich}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F10" sourceRef="GW_Bedarf" targetRef="End_Ausreichend" name="Nein"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!nachversorgungErforderlich}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F11" sourceRef="XOR_BF" targetRef="CA_Bestellfreigabe"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F12" sourceRef="CA_Bestellfreigabe" targetRef="GW_Freigabe"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F13" sourceRef="GW_Freigabe" targetRef="CA_Bestellabwicklung" name="Bestellung freigegeben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellfreigabeErgebnis == 'Bestellung freigegeben'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F14" sourceRef="GW_Freigabe" targetRef="End_NichtZulaessig" name="Bestellung nicht zulässig"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellfreigabeErgebnis == 'Bestellung nicht zulässig'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F15" sourceRef="GW_Freigabe" targetRef="End_NichtFreigegeben" name="Bestellung nicht freigegeben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellfreigabeErgebnis == 'Bestellung nicht freigegeben'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F16" sourceRef="GW_Freigabe" targetRef="End_Aufgeschoben" name="Bestellung aufgeschoben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellfreigabeErgebnis == 'Bestellung aufgeschoben'}</bpmn:conditionExpression></bpmn:sequenceFlow>
