</bpmn:collaboration>
<bpmn:process id="T2_Materialversorgung" name="Materialversorgung" isExecutable="true" camunda:historyTimeToLive="P180D">
<bpmn:documentation>Hauptprozess Team 2: Ausgewählte Verbrauchsprodukte rechtzeitig und kontrolliert nachversorgen (Teamauftrag 2, Abschnitt 4, Schritte 1-12). Eine Prozessinstanz = ein Nachversorgungsvorgang für ein Produkt eines Pflegehaushalts. Drei Nachrichtenstarts (Prüflauf, Pflege-App, Esper), Teilprozesse als Call Activities (Call by Value).</bpmn:documentation>
<bpmn:startEvent id="Start_Schwelle" name="Schwellenwert unterschritten"><bpmn:documentation>Nachrichtenstart: Esper (Ereignisverarbeitung) erkennt aus Bestands- und Verbrauchsereignissen die Unterschreitung des vereinbarten Schwellenwerts und meldet sie über Camel an den Prozess.</bpmn:documentation><bpmn:outgoing>F06</bpmn:outgoing><bpmn:messageEventDefinition id="Start_Schwelle_Def" messageRef="Msg_Schwellenwert" /></bpmn:startEvent>
<bpmn:startEvent id="Start_Manuell" name="Bestand manuell gemeldet"><bpmn:documentation>Nachrichtenstart: Die Pflegeperson meldet den Bestand über die Pflege-App.</bpmn:documentation><bpmn:outgoing>F01</bpmn:outgoing><bpmn:messageEventDefinition id="Start_Manuell_Def" messageRef="Msg_Bestandsmeldung" /></bpmn:startEvent>
<bpmn:startEvent id="Start_Pruefung" name="Prüfung angestoßen"><bpmn:documentation>Nachrichtenstart: Der Prozess "Prüflauf" (T2_Prueflauf) sendet je fälligem Versorgungsprofil einen Prüfauftrag. So entsteht je Haushalt und Produkt genau eine Instanz (Instanz-Ausrichtung nach Stiehl).</bpmn:documentation><bpmn:outgoing>F02</bpmn:outgoing><bpmn:messageEventDefinition id="Start_Pruefung_Def" messageRef="Msg_Pruefauftrag" /></bpmn:startEvent>
<bpmn:callActivity id="CA_Bestandsabfrage" name="Bestandsabfrage" calledElement="T2_Bestandsabfrage" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="produktId" target="produktId" /><camunda:out source="bestandMenge" target="bestandMenge" /><camunda:out source="bestandZeitpunkt" target="bestandZeitpunkt" /></bpmn:extensionElements><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:callActivity>
<bpmn:boundaryEvent id="B_Meldefrist" name="Meldefrist abgelaufen (3 Tage)" attachedToRef="CA_Bestandsabfrage"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): endgültige Meldefrist 3 Tage (unterbrechender Timer am Teilprozess).</bpmn:documentation><bpmn:outgoing>F04</bpmn:outgoing><bpmn:timerEventDefinition id="B_Meldefrist_Def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:endEvent id="End_KeineMeldung" name="Keine Bestandsmeldung"><bpmn:incoming>F04</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW_Start" name=""><bpmn:incoming>F01</bpmn:incoming><bpmn:incoming>F03</bpmn:incoming><bpmn:incoming>F06</bpmn:incoming><bpmn:outgoing>F07</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:callActivity id="CA_Bedarfsermittlung" name="Bedarfsermittlung" calledElement="T2_Bedarfsermittlung" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="produktId" target="produktId" /><camunda:in source="bestandMenge" target="bestandMenge" /><camunda:in source="bestandZeitpunkt" target="bestandZeitpunkt" /><camunda:out source="bedarfsermittlungErgebnis" target="bedarfsermittlungErgebnis" /><camunda:out source="nachversorgungsbedarf" target="nachversorgungsbedarf" /><camunda:out source="reichweiteTage" target="reichweiteTage" /><camunda:out source="verbrauchssprung" target="verbrauchssprung" /></bpmn:extensionElements><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_Bedarf" name="Nachversorgung erforderlich?"><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Ausreichend" name="Bestand ausreichend"><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent>
<bpmn:callActivity id="CA_Bestellfreigabe" name="Bestellfreigabe" calledElement="T2_Bestellfreigabe" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="produktId" target="produktId" /><camunda:in source="nachversorgungsbedarf" target="nachversorgungsbedarf" /><camunda:in source="verbrauchssprung" target="verbrauchssprung" /><camunda:in source="ersatzGrund" target="ersatzGrund" /><camunda:out source="bestellfreigabeErgebnis" target="bestellfreigabeErgebnis" /><camunda:out source="bestellvorschlag" target="bestellvorschlag" /></bpmn:extensionElements><bpmn:incoming>F09</bpmn:incoming><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_Freigabe" name="Bestellung freigegeben?"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing><bpmn:outgoing>F13b</bpmn:outgoing><bpmn:outgoing>F14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_NichtFreigegeben" name="Bestellung nicht freigegeben"><bpmn:incoming>F13</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_KeineEinigung" name="Keine Einigung"><bpmn:incoming>F13b</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_NichtZulaessig" name="Bestellung nicht zulässig"><bpmn:incoming>F14</bpmn:incoming></bpmn:endEvent>
<bpmn:callActivity id="CA_Bestellabwicklung" name="Bestellabwicklung" calledElement="T2_Bestellabwicklung" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="bestellvorschlag" target="bestellvorschlag" /><camunda:out source="bestellabwicklungErgebnis" target="bestellabwicklungErgebnis" /><camunda:out source="bestellung" target="bestellung" /><camunda:out source="ersatzGrund" target="ersatzGrund" /></bpmn:extensionElements><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_Bestellung" name="Bestellung bestätigt?"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:callActivity id="CA_Lieferpruefung" name="Lieferprüfung" calledElement="T2_Lieferpruefung" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="bestellung" target="bestellung" /><camunda:out source="lieferpruefungErgebnis" target="lieferpruefungErgebnis" /><camunda:out source="lieferung" target="lieferung" /></bpmn:extensionElements><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_Lieferung" name="Lieferung abgeschlossen?"><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing><bpmn:outgoing>F20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Ungeklaert" name="Lieferung ungeklärt"><bpmn:incoming>F20</bpmn:incoming></bpmn:endEvent>
<bpmn:callActivity id="CA_Vorgangsabschluss" name="Vorgangsabschluss" calledElement="T2_Vorgangsabschluss" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="produktId" target="produktId" /><camunda:in source="bestellung" target="bestellung" /><camunda:in source="lieferung" target="lieferung" /></bpmn:extensionElements><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing></bpmn:callActivity>
<bpmn:endEvent id="End_Abgeschlossen" name="Nachversorgung abgeschlossen"><bpmn:incoming>F21</bpmn:incoming></bpmn:endEvent>
