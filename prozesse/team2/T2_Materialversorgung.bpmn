<bpmn:messageFlow id="M00a" name="Prüfauftrag" sourceRef="P_Prueflauf" targetRef="Start_Pruefung" />
<bpmn:messageFlow id="M00b" name="Bestandsmeldung" sourceRef="P_PflegeApp" targetRef="Start_Manuell" />
<bpmn:messageFlow id="M00c" name="Unterschreitung" sourceRef="P_Esper" targetRef="Start_Schwelle" />
<bpmn:messageFlow id="M01" name="Bestellung" sourceRef="CA_Bestellabwicklung" targetRef="P_Lieferant" />
<bpmn:messageFlow id="M02" name="Bestellantwort" sourceRef="P_Lieferant" targetRef="CA_Bestellabwicklung" />
<bpmn:messageFlow id="M03" name="Nachfassauftrag" sourceRef="CA_Bestellabwicklung" targetRef="P_Team3" />
<bpmn:messageFlow id="M04" name="Versandmeldung" sourceRef="P_Lieferant" targetRef="CA_Lieferpruefung" />
