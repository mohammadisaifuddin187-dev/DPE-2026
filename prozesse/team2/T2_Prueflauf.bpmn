<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_T2_Prueflauf" targetNamespace="http://thi.de/dpe/team2" exporter="Team 2 (KI-unterstützt)" exporterVersion="1.0">
<bpmn:collaboration id="Collab_T2_Prueflauf">
<bpmn:participant id="P_Prueflauf" name="Prüflauf" processRef="T2_Prueflauf" />
<bpmn:participant id="P_Materialversorgung" name="Materialversorgung (Team 2)" />
<bpmn:messageFlow id="M01" name="Prüfauftrag" sourceRef="S_Auftrag" targetRef="P_Materialversorgung" />
</bpmn:collaboration>
<bpmn:process id="T2_Prueflauf" name="Prüflauf" isExecutable="true" camunda:historyTimeToLive="P180D">
<bpmn:documentation>Eigener Prozess für den geplanten Prüftermin. Eine Instanz = ein Prüflauf (täglich). Er ermittelt die fälligen Versorgungsprofile und sendet je Profil einen Prüfauftrag, der im Hauptprozess genau eine Instanz je Haushalt und Produkt startet. Grund: Prüflauf und Nachversorgungsvorgang haben keine 1:1-Beziehung, deshalb zwei getrennte Prozesse (Stiehl, Best Practices: Instanz-Ausrichtung).</bpmn:documentation>
<bpmn:startEvent id="Start" name="Prüftermin erreicht (täglich 6 Uhr)"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): täglicher Prüflauf um 6 Uhr.</bpmn:documentation><bpmn:outgoing>F1</bpmn:outgoing><bpmn:timerEventDefinition id="Start_Def"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 6 * * ?</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:serviceTask id="T_Profile" name="Fällige Versorgungsprofile ermitteln" camunda:type="external" camunda:topic="t2-faellige-profile"><bpmn:documentation>Liest alle Versorgungsprofile, deren nächster Prüfzeitpunkt erreicht ist (Persistenz), und setzt die Liste faelligeProfile (je Eintrag pflegehaushaltId, produktId).</bpmn:documentation><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="S_Auftrag" name="Prüfauftrag senden" camunda:type="external" camunda:topic="t2-pruefauftrag-senden"><bpmn:documentation>Mehrfachinstanz (parallel) über faelligeProfile: je Profil eine Nachricht Prueflauf_Pruefauftrag_Team2 an den Hauptprozess. Leere Liste = Aufgabe wird sofort beendet.</bpmn:documentation><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="false" camunda:collection="${faelligeProfile}" camunda:elementVariable="profil" /></bpmn:sendTask>
<bpmn:endEvent id="End" name="Prüfaufträge versendet"><bpmn:incoming>F3</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Profile"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F2" sourceRef="T_Profile" targetRef="S_Auftrag"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F3" sourceRef="S_Auftrag" targetRef="End"></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="BPMNDiagram_1"><bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_T2_Prueflauf">
<bpmndi:BPMNShape id="P_Prueflauf_di" bpmnElement="P_Prueflauf" isHorizontal="true"><dc:Bounds x="120" y="80" width="700" height="200" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="P_Materialversorgung_di" bpmnElement="P_Materialversorgung" isHorizontal="true"><dc:Bounds x="120" y="340" width="700" height="60" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="192" y="162" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="155" y="202" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T_Profile_di" bpmnElement="T_Profile"><dc:Bounds x="290" y="140" width="140" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Auftrag_di" bpmnElement="S_Auftrag" bioc:stroke="#616161" bioc:fill="#E0E0E0" color:background-color="#E0E0E0" color:border-color="#616161"><dc:Bounds x="490" y="140" width="140" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="702" y="162" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="675" y="202" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="228" y="180" /><di:waypoint x="290" y="180" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="430" y="180" /><di:waypoint x="490" y="180" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="630" y="180" /><di:waypoint x="702" y="180" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="M01_di" bpmnElement="M01"><di:waypoint x="560" y="220" /><di:waypoint x="560" y="340" /><bpmndi:BPMNLabel><dc:Bounds x="566" y="280" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
