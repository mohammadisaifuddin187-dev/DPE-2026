<?xml version="1.0" encoding="UTF-8"?>
<!-- KI-generiert (Claude, Anthropic) - Beginn. Team 2 Materialversorgung, Pflege-Backoffice MVP, DPE WS 2026/27 (Prof. Stiehl). Verantwortlich im Team: offen (Team 2 legt fest). Lizenz: MIT. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_T2_Kundenentscheidung" targetNamespace="http://thi.de/dpe/team2" exporter="Team 2 (KI-unterstützt)" exporterVersion="1.0">
<bpmn:collaboration id="Collab_T2_Kundenentscheidung">
<bpmn:participant id="P_Kundenentscheidung" name="Kundenentscheidung (gemeinsamer Baustein)" processRef="T2_Kundenentscheidung" />
</bpmn:collaboration>
<bpmn:process id="T2_Kundenentscheidung" name="Kundenentscheidung" isExecutable="true" camunda:historyTimeToLive="P180D">
<bpmn:documentation>Gemeinsamer, wiederverwendbarer Baustein (Team 2 verantwortet Kundenfreigaben für alle Teams, Handbuch 6.2 / 7.4). Eingaben: freigabeHandlung, freigabeBegruendung, freigabeFolgen, freigabeGueltigBis. Ergebnis kundenentscheidungErgebnis: Freigegeben | Änderung gewünscht | Nicht freigegeben. Erinnerung = nicht unterbrechender Timer; Antwortfrist = unterbrechender Timer. Keine stillschweigende Freigabe bei fehlender Antwort.</bpmn:documentation>
<bpmn:laneSet id="T2_Kundenentscheidung_LaneSet">
<bpmn:lane id="Lane_Pflegeperson" name="Pflegeperson"><bpmn:flowNodeRef>UT_Entscheiden</bpmn:flowNodeRef><bpmn:flowNodeRef>B_Erinnerung</bpmn:flowNodeRef><bpmn:flowNodeRef>B_Frist</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Entscheidung</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Freigegeben</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Aenderung</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NichtFreigegeben</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Backoffice" name="Pflege-Backoffice"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Zustellen</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Erinnern</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Erinnert</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start" name="Entscheidung angefordert"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="T_Zustellen" name="Freigabeanfrage zustellen" camunda:type="external" camunda:topic="t2-benachrichtigung"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="vorlage">FREIGABEANFRAGE</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="UT_Entscheiden" name="Freigabe entscheiden" camunda:candidateGroups="pflegeperson"><bpmn:documentation>Anlass: Handlung benötigt ausdrückliche Kundenfreigabe. Benötigt: Handlung, Begründung, Folgen, Gültigkeit. Rolle: Pflegeperson. Ergebnis: Freigabe, Änderung, Ablehnung oder Aufschub. Erinnerung nach 1 Tag, Antwortfrist 3 Tage. Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen):</bpmn:documentation><bpmn:extensionElements><camunda:formData><camunda:formField id="freigabeHandlung" label="Handlung" type="string"><camunda:validation><camunda:constraint name="readonly" /></camunda:validation></camunda:formField><camunda:formField id="freigabeBegruendung" label="Begründung / Abweichung" type="string"><camunda:validation><camunda:constraint name="readonly" /></camunda:validation></camunda:formField><camunda:formField id="freigabeFolgen" label="Folgen der Entscheidung" type="string"><camunda:validation><camunda:constraint name="readonly" /></camunda:validation></camunda:formField><camunda:formField id="entscheidung" label="Entscheidung" type="enum"><camunda:validation><camunda:constraint name="required" /></camunda:validation><camunda:value id="FREIGEBEN" name="Freigeben" /><camunda:value id="AENDERN" name="Änderung wünschen" /><camunda:value id="ABLEHNEN" name="Ablehnen" /><camunda:value id="AUFSCHIEBEN" name="Aufschieben" /></camunda:formField><camunda:formField id="kundenentscheidungKommentar" label="Kommentar" type="string"></camunda:formField></camunda:formData></bpmn:extensionElements><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="B_Erinnerung" name="Erinnerung fällig (1 Tag)" attachedToRef="UT_Entscheiden" cancelActivity="false"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): Erinnerung nach 1 Tag.</bpmn:documentation><bpmn:outgoing>F7</bpmn:outgoing><bpmn:timerEventDefinition id="B_Erinnerung_Def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="B_Frist" name="Antwortfrist abgelaufen (3 Tage)" attachedToRef="UT_Entscheiden"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): Antwortfrist 3 Tage; danach "Nicht freigegeben" (keine stillschweigende Freigabe).</bpmn:documentation><bpmn:outgoing>F9</bpmn:outgoing><bpmn:timerEventDefinition id="B_Frist_Def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:serviceTask id="T_Erinnern" name="An Freigabe erinnern" camunda:type="external" camunda:topic="t2-benachrichtigung"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="vorlage">FREIGABEERINNERUNG</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Erinnert" name="Erinnerung zugestellt"><bpmn:incoming>F8</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW_Entscheidung" name="Entscheidung?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing><bpmn:outgoing>F6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Freigegeben" name="Freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungErgebnis', 'Freigegeben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_Aenderung" name="Änderung gewünscht"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungErgebnis', 'Änderung gewünscht')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F5</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_NichtFreigegeben" name="Nicht freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungErgebnis', 'Nicht freigegeben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F6</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Zustellen"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F2" sourceRef="T_Zustellen" targetRef="UT_Entscheiden"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F3" sourceRef="UT_Entscheiden" targetRef="GW_Entscheidung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F4" sourceRef="GW_Entscheidung" targetRef="End_Freigegeben" name="Freigegeben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'FREIGEBEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F5" sourceRef="GW_Entscheidung" targetRef="End_Aenderung" name="Änderung gewünscht"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'AENDERN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F6" sourceRef="GW_Entscheidung" targetRef="End_NichtFreigegeben" name="Abgelehnt oder aufgeschoben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'ABLEHNEN' || entscheidung == 'AUFSCHIEBEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F7" sourceRef="B_Erinnerung" targetRef="T_Erinnern"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F8" sourceRef="T_Erinnern" targetRef="End_Erinnert"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F9" sourceRef="B_Frist" targetRef="End_NichtFreigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungKommentar', 'Keine Rückmeldung innerhalb der Frist')}" event="take" /></bpmn:extensionElements></bpmn:sequenceFlow>
</bpmn:process>
