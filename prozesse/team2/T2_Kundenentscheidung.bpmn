<?xml version="1.0" encoding="UTF-8"?>
<!-- KI-generiert (Claude, Anthropic) - Beginn. Team 2 Materialversorgung, Pflege-Backoffice MVP, DPE WS 2026/27 (Prof. Stiehl). Verantwortlich im Team: Saifudin Mohammadi (BPMN). Lizenz: MIT. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_T2_Kundenentscheidung" targetNamespace="http://thi.de/dpe/team2" exporter="Team 2 (KI-unterstützt)" exporterVersion="1.0">
<bpmn:collaboration id="Collab_T2_Kundenentscheidung">
<bpmn:participant id="P_PflegeApp" name="Pflege-App" />
<bpmn:participant id="P_Kundenentscheidung" name="Kundenentscheidung (gemeinsamer Baustein) - Materialversorgung (Team 2)" processRef="T2_Kundenentscheidung" />
<bpmn:participant id="P_Team3" name="Team 3 - Kommunikation, Fristen, Nachfassen" />
<bpmn:messageFlow id="M01" name="Freigabe-Anfrage" sourceRef="S_Anfrage" targetRef="P_PflegeApp" />
<bpmn:messageFlow id="M02" name="Kunden-Entscheidung" sourceRef="P_PflegeApp" targetRef="R_Entscheidung" />
<bpmn:messageFlow id="M03" name="Nachfass-Auftrag" sourceRef="S_Nachfassen" targetRef="P_Team3" />
</bpmn:collaboration>
<bpmn:process id="T2_Kundenentscheidung" name="Kundenentscheidung" isExecutable="true" camunda:historyTimeToLive="P180D">
<bpmn:documentation>Gemeinsamer Baustein (Team 2 verantwortet Kundenfreigaben, Handbuch 6.2 / 7.4). Die Pflege-App ist ein eigenständiges System: Anfrage senden, Entscheidung empfangen. Ablauf der Frist: wie überall Nachfassen über Team 3, danach einmal erneut warten (Stiehl Punkt 4). Ergebnis kundenentscheidungErgebnis: Freigegeben | Änderung gewünscht | Aufgeschoben | Nicht freigegeben; bei "Nicht freigegeben" sagt kundenentscheidungGrund, ob abgelehnt oder keine Antwort (Stiehl Punkt 5). Keine Antwort ist nie eine Freigabe.</bpmn:documentation>
<bpmn:startEvent id="Start" name="Entscheidung angefordert"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('nachgefasst', false)}" event="start" /></bpmn:extensionElements><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
<bpmn:sendTask id="S_Anfrage" name="Freigabeanfrage senden" camunda:type="external" camunda:topic="t2-freigabeanfrage-senden"><bpmn:documentation>Nachricht an die Pflege-App mit Handlung, Begründung, Folgen und Gültigkeit.</bpmn:documentation><bpmn:incoming>F01</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="XOR_W" name=""><bpmn:incoming>F02</bpmn:incoming><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:receiveTask id="R_Entscheidung" name="Kundenentscheidung empfangen" messageRef="Msg_Kundenentscheidung"><bpmn:documentation>Antwort aus der Pflege-App, Variable entscheidung: FREIGEBEN, AENDERN, ABLEHNEN, AUFSCHIEBEN.</bpmn:documentation><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:receiveTask>
<bpmn:boundaryEvent id="B_Frist" name="Antwortfrist abgelaufen (3 Tage)" attachedToRef="R_Entscheidung"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): Antwortfrist 3 Tage.</bpmn:documentation><bpmn:outgoing>F09</bpmn:outgoing><bpmn:timerEventDefinition id="B_Frist_Def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="GW_Nach" name="Bereits nachgefasst?"><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="S_Nachfassen" name="Nachfassen beauftragen" camunda:type="external" camunda:topic="t2-nachfassen-beauftragen"><bpmn:documentation>Team 3 fasst bei der Pflegeperson nach. Schnittstelle = Vorschlag zur Abstimmung.</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('nachgefasst', true)}" event="end" /></bpmn:extensionElements><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="GW_E" name="Entscheidung?"><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing><bpmn:outgoing>F06</bpmn:outgoing><bpmn:outgoing>F07</bpmn:outgoing><bpmn:outgoing>F08</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Aenderung" name="Änderung gewünscht"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungErgebnis', 'Änderung gewünscht')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F05</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_Aufgeschoben" name="Aufgeschoben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungErgebnis', 'Aufgeschoben')}" event="start" /><camunda:executionListener expression="${execution.setVariable('kundenentscheidungGrund', 'Kunde: aufgeschoben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F06</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_Freigegeben" name="Freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungErgebnis', 'Freigegeben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F07</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="XOR_NF" name=""><bpmn:incoming>F08</bpmn:incoming><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_NichtFreigegeben" name="Nicht freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungErgebnis', 'Nicht freigegeben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F13</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="S_Anfrage"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F02" sourceRef="S_Anfrage" targetRef="XOR_W"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F03" sourceRef="XOR_W" targetRef="R_Entscheidung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F04" sourceRef="R_Entscheidung" targetRef="GW_E"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F05" sourceRef="GW_E" targetRef="End_Aenderung" name="Änderung gewünscht"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'AENDERN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F06" sourceRef="GW_E" targetRef="End_Aufgeschoben" name="Aufgeschoben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'AUFSCHIEBEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F07" sourceRef="GW_E" targetRef="End_Freigegeben" name="Freigegeben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'FREIGEBEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F08" sourceRef="GW_E" targetRef="XOR_NF" name="Abgelehnt"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungGrund', 'Kunde: abgelehnt')}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'ABLEHNEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F09" sourceRef="B_Frist" targetRef="GW_Nach"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F10" sourceRef="GW_Nach" targetRef="S_Nachfassen" name="Nein"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!nachgefasst}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F11" sourceRef="S_Nachfassen" targetRef="XOR_W"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F12" sourceRef="GW_Nach" targetRef="XOR_NF" name="Ja (keine Antwort)"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungGrund', 'Kunde: keine Antwort trotz Nachfassen')}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nachgefasst}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F13" sourceRef="XOR_NF" targetRef="End_NichtFreigegeben"></bpmn:sequenceFlow>
</bpmn:process>
<bpmn:message id="Msg_Kundenentscheidung" name="PflegeApp_Kundenentscheidung_Team2" />
